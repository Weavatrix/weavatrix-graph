{
  "architectureContractV": 1,
  "name": "Weavatrix Graph layered graph-core architecture",
  "style": "layered-modules",
  "enforcement": "strict",
  "components": [
    {
      "id": "model",
      "name": "Evidence model and validation primitives",
      "paths": [
        "src/attribute.rs",
        "src/error.rs",
        "src/filter.rs",
        "src/kind",
        "src/model"
      ]
    },
    {
      "id": "views",
      "name": "Topology, matrix, and graph-view contracts",
      "paths": [
        "src/matrix",
        "src/operator.rs",
        "src/topology",
        "src/undirected",
        "src/view"
      ]
    },
    {
      "id": "algorithms",
      "name": "Generic graph algorithms",
      "paths": ["src/algo"]
    },
    {
      "id": "storage",
      "name": "Canonical, mutable, payload, and traversal storage",
      "paths": [
        "src/graph",
        "src/payload",
        "src/traversal_cache",
        "src/working"
      ]
    },
    {
      "id": "interchange",
      "name": "Formats, generators, and legacy conversion",
      "paths": [
        "src/format",
        "src/generator",
        "src/legacy.rs"
      ]
    },
    {
      "id": "facade",
      "name": "Public crate facade",
      "paths": ["src/lib.rs"]
    },
    {
      "id": "verification",
      "name": "Tests, benchmarks, examples, and fuzz targets",
      "paths": [
        "benches",
        "examples",
        "fuzz",
        "tests"
      ]
    }
  ],
  "dependencyRules": [
    {
      "id": "runtime-does-not-depend-on-verification",
      "action": "forbid",
      "from": ["model", "views", "algorithms", "storage", "interchange", "facade"],
      "to": ["verification"],
      "kinds": ["imports", "re_exports", "depends_on"]
    }
  ],
  "budgets": {
    "runtimeCycles": 0,
    "maxFileLoc": 300,
    "maxFunctionLoc": 100
  },
  "technologies": {
    "required": ["rust"],
    "forbidden": []
  },
  "exceptions": [],
  "ratchet": {
    "baseline": {
      "fingerprints": [],
      "metrics": {}
    }
  }
}
